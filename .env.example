# すべてサーバー専用の値です。NEXT_PUBLIC_ を付けないでください（ブラウザに送られてしまいます）。
# ローカルでは .env.local にコピーして使います（.env.local は Git に含まれません）。

# --- データベース（必須）---
# ローカル：npm run db:local:reset で作る PostgreSQL
# 公開環境：Vercel の Storage から Neon を接続すると DATABASE_URL と DATABASE_URL_UNPOOLED が自動で入る
#   Supabase の場合：DATABASE_URL に「Transaction pooler」（6543）、DATABASE_URL_UNPOOLED に「Session pooler」（5432）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docflow
# DATABASE_URL_UNPOOLED=

# --- 見本の組織（admin@ / staff@ / viewer@docflow.example）のログイン用パスワード ---
# 公開環境では必須（12文字以上）。ローカルで未設定なら docflow-demo-2026
# SEED_LOGIN_PASSWORD=

# --- 毎日の定期処理（Vercel Cron：期限切れデモの削除・見本データの作り直し）の合言葉 ---
# 公開環境では必須（16文字以上のランダムな文字列）
CRON_SECRET=

# --- OCR（任意）---
# 既定は tesseract（このシステムのサーバーの中で読む。外部に送らない・追加の費用なし）
# google-document-ai にすると、画像・スキャン PDF を Google Cloud に送って読む（要：課金の設定・サービスアカウント）
# OCR_PROVIDER=tesseract
# GOOGLE_DOCUMENT_AI_PROCESSOR=projects/<プロジェクト>/locations/<us|eu>/processors/<プロセッサの ID>
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   （JSON をそのまま1行で）

# --- AI による項目の読み取り（任意）---
# 未設定なら、ルール（書類の文字の並びと位置）だけで読み取る。外部の AI には何も送らない。
# ANTHROPIC_API_KEY と LLM_MODEL の両方を設定し、設定画面で管理者が「外部の AI を使う」をオンにした組織だけ、書類の文字を送る。
# デモ環境（訪問者ごと）では、この値があっても外部の AI は使わない。
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic          （none にすると、キーがあっても使わない）
# LLM_MODEL=                      （使うモデルの ID。Anthropic のドキュメントのモデル一覧から選ぶ）
# LLM_MASK_SENSITIVE=true         （送る前に口座番号・電話番号を伏せる）
# LLM_FALLBACK_TO_RULES=true      （AI が失敗したらルールの読み取りに切り替える）

# --- 読み取りの処理（任意）---
# EXTRACTION_CONCURRENCY=2        同時に動かす読み取りの数
# EXTRACTION_MAX_ATTEMPTS=3       失敗したときに試す回数
# EXTRACTION_TIMEOUT_SECONDS=50   1ファイルの処理の上限（秒）

# --- 書類のファイルの保存先（任意）---
# 未設定なら DB（非公開の表 app_private.file_blobs）に保存する。
# 両方あれば Supabase Storage の非公開バケット documents に保存する。
# サービスロールキーは強い権限を持つ秘密の値です。サーバーの環境変数にだけ置き、公開しないでください。
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- アップロード・デモ（任意）---
# UPLOAD_BODY_LIMIT_MB=20         1回の送信の上限（Vercel では既定 4。Vercel の関数は 4.5MB まで）
# DEMO_MAX_ACTIVE=40              同時に存在できるデモ環境の数
# DEMO_CREATE_LIMIT_PER_HOUR=30   同じ接続元から1時間に作れるデモ環境の数
# DEMO_UPLOAD_LIMIT_PER_HOUR=20   デモ環境で1時間にアップロードできるファイルの数
